{
  "version": "1.0.0",
  "theme": "light",
  "color": {
    "brand": {
      "primary": "#2C863B",
      "onPrimary": "#FFFFFF"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#515A53",
      "disabled": "#69736C"
    },
    "surface": {
      "canvas": "#FFFFFF",
      "card": "#FFFFFF",
      "raised": "#FFFFFF",
      "subtle": "#F5F7F4"
    },
    "border": {
      "default": "#D7E0D7",
      "strong": "#768476",
      "focus": "#2C863B"
    },
    "status": {
      "success": {
        "color": "#176B31",
        "onColor": "#FFFFFF",
        "surface": "#E8F5EC",
        "text": "#176B31"
      },
      "warning": {
        "color": "#794600",
        "onColor": "#FFFFFF",
        "surface": "#FFF4D6",
        "text": "#794600"
      },
      "danger": {
        "color": "#A1241B",
        "onColor": "#FFFFFF",
        "surface": "#FDE8E7",
        "text": "#A1241B"
      },
      "info": {
        "color": "#174A7E",
        "onColor": "#FFFFFF",
        "surface": "#E8F1FB",
        "text": "#174A7E"
      }
    }
  },
  "typography": {
    "family": "Plus Jakarta Sans",
    "fallback": ["system-ui", "sans-serif"],
    "scale": {
      "display": 48,
      "h1": 40,
      "h2": 32,
      "h3": 24,
      "body": 16,
      "bodySmall": 14,
      "caption": 12
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "tracking": {
      "tight": -0.02,
      "normal": 0,
      "wide": 0.08
    }
  },
  "spacing": {
    "base": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64]
  },
  "radius": {
    "control": 12,
    "card": 12,
    "panel": 12,
    "pill": 999
  },
  "elevation": {
    "none": {
      "web": "none",
      "android": 0,
      "iosOpacity": 0
    },
    "raised": {
      "web": "0 2px 8px rgba(0, 0, 0, 0.08)",
      "android": 2,
      "iosOpacity": 0.08
    },
    "floating": {
      "web": "0 12px 32px rgba(0, 0, 0, 0.14)",
      "android": 8,
      "iosOpacity": 0.14
    }
  },
  "control": {
    "minHeight": 44,
    "iconSize": 20,
    "touchTarget": 44
  },
  "icon": {
    "style": "outline",
    "strokeWidth": 1.8,
    "defaultSize": 20
  },
  "breakpoint": {
    "compact": 360,
    "medium": 640,
    "expanded": 1024,
    "wide": 1280
  },
  "safeArea": {
    "web": "env(safe-area-inset-*)",
    "native": "Use SafeAreaView or safe-area-context insets"
  }
}
